# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Чат, куда приходят заявки: личный чат администратора или группа.
# Узнать ID: добавьте бота в чат и отправьте /id
ADMIN_CHAT_ID=

# Часовой пояс салона и рабочие часы
TIMEZONE=Europe/Moscow
WORK_OPEN=10:00
WORK_CLOSE=21:00
SLOT_STEP_MINUTES=30
# На сколько дней вперёд можно записаться
BOOKING_DAYS_AHEAD=14
# Сколько клиентов можно принять одновременно (кабинеты/мастера)
CAPACITY=1
# Минимум минут от текущего момента до записи
LEAD_MINUTES=60

# Файл с записями
DATA_FILE=data/bookings.json

# Приём заявок с сайта: POST http://<сервер>:<порт>/booking. 0 — выключить.
HTTP_PORT=8787
# Домены сайта через запятую (CORS), например https://aesthetic-body.ru
ALLOWED_ORIGINS=http://localhost:5173

# Контакты в сообщениях бота
SALON_NAME=Aesthetic Body
SALON_PHONE=+7 (920) 832-22-28
SALON_ADDRESS=ТЦ «Соловьи», Брянск, ул. Дуки, 63, 2 этаж
SALON_HOURS=ежедневно 10:00–21:00
