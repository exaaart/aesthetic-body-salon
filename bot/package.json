{
  "name": "aesthetic-body-bot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Telegram-бот записи на процедуры салона Aesthetic Body",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "tsc && node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test dist/test/"
  },
  "dependencies": {
    "grammy": "^1.46.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.6.3"
  }
}
